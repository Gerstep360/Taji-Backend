# Copia este archivo como .env y reemplaza todos los valores de ejemplo.
DEBUG=True
DJANGO_SECRET_KEY=reemplaza-por-una-clave-larga-y-aleatoria
JWT_SIGNING_KEY=reemplaza-por-otra-clave-larga-y-aleatoria
# En producción define el dominio exacto:
# ALLOWED_HOSTS=taji.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100
FRONTEND_URLS=http://localhost:4200,http://127.0.0.1:4200,http://192.168.1.100:4200

# PostgreSQL 18 local. Ajusta usuario y contraseña creados durante la instalación.
DATABASE_URL=postgresql://taji:CAMBIA_ESTA_PASSWORD@localhost:5432/taji
Password_DB=
DB_CONN_MAX_AGE=60

COOKIE_SECURE=False
COOKIE_SAMESITE=Lax
PASSWORD_RESET_URL=http://localhost:4200/restablecer-contrasena

# --- Correo (invitaciones de acceso y recuperación de contraseña) ---
# El backend de consola NO envía nada: acepta el mensaje y lo escribe en el
# log. Es útil en desarrollo, pero en producción significa que las invitaciones
# nunca llegan, por eso la API lo reporta explícitamente en vez de fingir éxito.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Taji <no-reply@taji.app>
# Para enviar correos reales, cambia EMAIL_BACKEND y completa estas variables.
# En Gmail usa una "contraseña de aplicación", no tu contraseña habitual:
# https://myaccount.google.com/apppasswords
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=tu-clave-de-aplicacion

# QR temporal de visita (RF-09 / T021).
# Bytes de entropía del token contenido en el QR (24 = 192 bits).
VISIT_QR_TOKEN_BYTES=24
# Vigencia por defecto del QR en minutos. Nunca supera el fin de la visita.
VISIT_QR_TTL_MINUTES=240
# Techo absoluto de la vigencia solicitada y mínimo aceptable.
VISIT_QR_MAX_TTL_MINUTES=1440
VISIT_QR_MIN_TTL_MINUTES=5
# Corrección de errores del símbolo: low | medium | quartile | high
VISIT_QR_ECC=medium
# Escala de la imagen renderizada por el backend.
VISIT_QR_IMAGE_SCALE=6

# Bitácora de escaneos del guardia (RF-10). Registra todo escaneo, incluidos
# los códigos QR inexistentes. Estos topes evitan que alguien llene la tabla
# escaneando cadenas aleatorias; los QR reales nunca se omiten.
QR_SCAN_UNKNOWN_LOG_LIMIT=30
QR_SCAN_UNKNOWN_LOG_WINDOW_MINUTES=60


