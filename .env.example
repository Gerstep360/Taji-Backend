# Copia este archivo como .env y reemplaza todos los valores de ejemplo.
DEBUG=True
DJANGO_SECRET_KEY=reemplaza-por-una-clave-larga-y-aleatoria
JWT_SIGNING_KEY=reemplaza-por-otra-clave-larga-y-aleatoria
# En producción define el dominio exacto:
# ALLOWED_HOSTS=taji.example.com
FRONTEND_URLS=http://localhost:4200,http://127.0.0.1:4200

# PostgreSQL 18 local. Ajusta usuario y contraseña creados durante la instalación.
DATABASE_URL=postgresql://taji:CAMBIA_ESTA_PASSWORD@localhost:5432/taji
Password_DB=
DB_CONN_MAX_AGE=60

COOKIE_SECURE=False
COOKIE_SAMESITE=Lax
PASSWORD_RESET_URL=http://localhost:4200/restablecer-contrasena
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Taji <no-reply@taji.app>
# Para enviar correos reales, reemplaza EMAIL_BACKEND y completa estas variables.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=tu-clave-de-aplicacion


