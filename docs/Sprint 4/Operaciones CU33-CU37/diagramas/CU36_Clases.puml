@startuml
skinparam backgroundColor white
skinparam shadowing false
title CU36 — Comparar cotizaciones con IA · Clases
class "Pantalla Cotizaciones" as UI <<boundary>>
class "Operations API" as API <<control>>
class "Cotización" as Record <<entity>> {
  Importe, moneda, plazo y meses de garantía
}
class "Condominio activo" as Tenant <<entity>>
UI --> API : Comparar dos a cinco cotizaciones
API --> Record : alcance y validación
Tenant "1" -- "0..*" Record
class "Asistente acotado" as Advisor <<control>>
class "Intento de análisis" as Attempt <<entity>>
API --> Advisor : comparte solo datos estructurados
API --> Attempt : verifica cuota
Advisor ..> Record : no modifica
@enduml
