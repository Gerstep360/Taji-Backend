@startuml
skinparam backgroundColor white
skinparam shadowing false
title CU33 — Gestionar garantías · Comunicacion
left to right direction
object "Administrador" as A
object "Garantías" as UI
object "API de Operaciones" as API
object "PostgreSQL" as DB
A --> UI : 1. Registrar / editar / eliminar garantía
UI --> API : 1.1. Solicitar operación
API --> DB : 1.2. Consultar condominio y registros
API --> API : 1.3. Validar garante, referencia y cobertura
API --> DB : 1.4. Persistir y auditar
API --> UI : 2. Actualizar lista o mostrar error
@enduml
