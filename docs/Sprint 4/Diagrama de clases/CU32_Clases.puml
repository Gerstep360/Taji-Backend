@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
allowmixing
title CU32 Reconocimiento por cámara — Incidencias e IA
left to right direction
skinparam dpi 160
skinparam classBackgroundColor #F8F9FA
skinparam classBorderColor #929DA8
hide circle
hide empty members
class "InterfazReconocimiento" as InterfazReconocimiento <<boundary>> {
  + iniciarCamara()
  + detenerCamara()
  + mostrarDetecciones()
}
class "ControladorCamara" as ControladorCamara <<control>> {
  + detectarFotograma()
  + recortarGuia()
  + liberarPistas()
}
class "ServicioPlacas" as ServicioPlacas <<control>> {
  + validarRecorte()
  + leerPlaca()
  + buscarPorCondominio()
}
class "SesionCamara" as SesionCamara <<entity>> {
  - estado
  - detecciones
  - eventosRecientes
}
class "ConsensoPlaca" as ConsensoPlaca <<control>> {
  + observar(placa, instante)
}
class "VehiculoDemo" as VehiculoDemo <<entity>> {
  - placa
  - descripcion
  - condominioId
}
class "Condominio" as Condominio <<entity>>
class "Panel de observaciones" as Panel <<boundary>> {
  + activarAnalisis(sector)
  + consultarHistorial()
  + guardarRevision()
}
class "Muestreador y disparador local" as Muestreador <<control>> {
  + compararEscena()
  + seleccionarVentana()
}
class "API de visión" as Vision <<control>> {
  + validarPermisosYCuotas()
  + encolarVentana()
  + consultarEvidencia()
}
class "Trabajador visual" as Worker <<control>> {
  + interpretarConNvidia()
  + recuperarAntecedentes()
  + deduplicar()
}
class "SesionVisual" as VisualSession <<entity>> {
  - sector
  - usuario
  - vencimiento
}
class "ObservacionVisual" as VisualObservation <<entity>> {
  - prediccion
  - estadoRevision
  - evidenciaOpcional
}
class "Incidencia" as Incident <<entity>>
actor "Operador" as A
A --> InterfazReconocimiento
InterfazReconocimiento --> ControladorCamara
ControladorCamara --> SesionCamara
ControladorCamara --> ConsensoPlaca
ControladorCamara --> ServicioPlacas
ServicioPlacas --> VehiculoDemo
Condominio "1" -- "0..*" VehiculoDemo
InterfazReconocimiento --> Panel
Panel --> Muestreador
Panel --> Vision
Vision --> VisualSession
Vision --> VisualObservation
Worker --> VisualObservation
Worker --> Incident : recupera antecedentes autorizados
Condominio "1" -- "0..*" VisualSession
VisualSession "1" -- "0..*" VisualObservation
@enduml
